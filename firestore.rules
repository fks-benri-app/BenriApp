rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 本人(ログインした生徒の uid = 生徒ID)だけが読める。書き込みは GAS(サービスアカウント)だけで、
    // サービスアカウントはルールを素通りするので、アプリからの書き込みは全部拒否する。
    match /users/{studentId}/announcements/{id} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      // 本人は既読の印(read と readAt)だけ書ける。内容や、リマインドの印は GAS だけが書く
      allow update: if request.auth != null && request.auth.uid == studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    // schoolEmail と pushBroken を含む生徒の情報。こちらも本人だけが読める。
    match /users/{studentId} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      // 通知の設定(notifyPrefs)だけ、本人が書き換えられる。ほかの項目は GAS だけが書く
      allow update: if request.auth != null && request.auth.uid == studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifyPrefs']);
      allow create, delete: if false;
    }

    // 通知の登録トークン(端末ごとに1件)。本人だけが読み書き・削除できる。
    // 書けるのは token と updatedAt だけ。token は文字列で512文字以下、updatedAt はサーバーの時刻に限る。
    match /users/{studentId}/fcmTokens/{tokenId} {
      allow read, delete: if request.auth != null && request.auth.uid == studentId;
      allow create, update: if request.auth != null && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 512
        && request.resource.data.updatedAt == request.time;
    }

    // ここに書いていないパスは、すべて拒否される(既定)。
  }
}
