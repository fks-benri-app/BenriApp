rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 本人(ログインした生徒の uid = 生徒ID)だけが読める。書き込みは GAS(サービスアカウント)だけで、
    // サービスアカウントはルールを素通りするので、アプリからの書き込みは全部拒否する。
    match /users/{studentId}/announcements/{id} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      // 本人は既読の印(read と readAt)だけ書ける。内容や、リマインドの印は GAS だけが書く
      allow update: if request.auth != null && request.auth.uid == studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    // schoolEmail と pushBroken を含む生徒の情報。こちらも本人だけが読める。
    match /users/{studentId} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      // 通知の設定(notifyPrefs)と、本人の設定(講座 courseLetter・選択教科 electiveSubjects)だけ、本人が書き換えられる。ほかの項目は GAS だけが書く
      allow update: if request.auth != null && request.auth.uid == studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifyPrefs', 'courseLetter', 'electiveSubjects']);
      allow create, delete: if false;
    }

    // 本人の所属授業(GAS が書く)。本人だけが読める。アプリは、この一覧で自分の授業を知る。
    match /users/{studentId}/courses/{courseId} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      allow write: if false;
    }

    // 授業ごとの投稿(全員宛て)を、授業の一覧(collection group)でまとめて読むための規則。
    // 投稿に入っている courseId の授業に、本人が所属しているときだけ読める。
    match /{path=**}/posts/{postId} {
      allow read: if request.auth != null
        && resource.data.keys().hasAny(['courseId'])
        && resource.data.courseId is string
        && resource.data.courseId.matches('^[0-9]+$') // 数字以外の ID は、パスを作る前に外す(判定の失敗を防ぐ)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/courses/$(resource.data.courseId));
      allow write: if false;
    }

    // 授業ごとの投稿(全員宛て)。書くのは GAS だけ。読めるのは、その授業のメンバーだけ。
    // メンバーかどうかは、本人の users/{生徒ID}/courses/{授業ID} があるかで決める(GAS が登録する)。
    match /courses/{courseId}/posts/{postId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/courses/$(courseId));
      allow write: if false;
    }

    // 既読の印(授業単位の保存に移ったあとの、生徒ごとの既読)。本人だけが読み書きできる。
    // reads は 投稿ID → 既読の時刻(ミリ秒)。ほかの項目は書けない。
    match /users/{studentId}/readState/{docId} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      allow create, update: if request.auth != null && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly(['reads'])
        && request.resource.data.reads is map;
      allow delete: if false;
    }

    // 通知の登録トークン(端末ごとに1件)。本人だけが読み書き・削除できる。
    // 書けるのは token と updatedAt だけ。token は文字列で512文字以下、updatedAt はサーバーの時刻に限る。
    match /users/{studentId}/fcmTokens/{tokenId} {
      allow read, delete: if request.auth != null && request.auth.uid == studentId;
      allow create, update: if request.auth != null && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 512
        && request.resource.data.updatedAt == request.time;
    }

    // ここに書いていないパスは、すべて拒否される(既定)。
  }
}
